{
  "agent": {"run_as_user": "root", "omit_hostname": true},
  "metrics": {
    "namespace": "Enshrouded",
    "append_dimensions": {"InstanceId": "${aws:InstanceId}"},
    "metrics_collected": {
      "mem": {"measurement": ["mem_used_percent"], "metrics_collection_interval": 60}
    }
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/srv/enshrouded/logs/enshrouded_server.log", "log_group_name": "/enshrouded/server", "log_stream_name": "game"},
          {"file_path": "/var/lib/docker/containers/*/*-json.log", "log_group_name": "/enshrouded/server", "log_stream_name": "container"},
          {"file_path": "/var/log/enshrouded-dashboard-backup.log", "log_group_name": "/enshrouded/server", "log_stream_name": "backup"}
        ]
      }
    }
  }
}
