{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SchedulerManage",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule", "scheduler:UpdateSchedule", "scheduler:DeleteSchedule", "scheduler:GetSchedule",
        "scheduler:CreateScheduleGroup", "scheduler:GetScheduleGroup", "scheduler:DeleteScheduleGroup",
        "scheduler:TagResource", "scheduler:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:scheduler:*:*:schedule-group/enshrouded",
        "arn:aws:scheduler:*:*:schedule/enshrouded/*"
      ]
    },
    {
      "Sid": "SchedulerList",
      "Effect": "Allow",
      "Action": ["scheduler:ListSchedules", "scheduler:ListScheduleGroups"],
      "Resource": "*"
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/enshrouded-scheduler",
      "Condition": {"StringEquals": {"iam:PassedToService": "scheduler.amazonaws.com"}}
    },
    {
      "Sid": "DynamoDBTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable", "dynamodb:DescribeTable", "dynamodb:DeleteTable",
        "dynamodb:UpdateTimeToLive", "dynamodb:DescribeTimeToLive", "dynamodb:TagResource",
        "dynamodb:GetItem", "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/enshrouded-*"
    },
    {
      "Sid": "DynamoDBList",
      "Effect": "Allow",
      "Action": "dynamodb:ListTables",
      "Resource": "*"
    },
    {
      "Sid": "SsmDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument", "ssm:UpdateDocument", "ssm:UpdateDocumentDefaultVersion",
        "ssm:DeleteDocument", "ssm:DescribeDocument", "ssm:GetDocument", "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:*:*:document/enshrouded-*"
    },
    {
      "Sid": "SsmRead",
      "Effect": "Allow",
      "Action": ["ssm:DescribeInstanceInformation", "ssm:ListCommands", "ssm:ListCommandInvocations"],
      "Resource": "*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:TagResource",
        "logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/enshrouded/*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/enshrouded-*"
      ]
    },
    {
      "Sid": "LogsDescribe",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
